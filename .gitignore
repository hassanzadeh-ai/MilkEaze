# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Data & artifacts (never commit raw sessions or trained weights).
# These are anchored with a leading slash on purpose: an unanchored `data/` also
# matches `milkeaze/data/`, which silently kept the whole ingestion package out of
# version control even though the pipeline imports it.
/data/
/datasets/
/new_dataset/
*.bin
*.wav
*.csv
!tests/**/*.csv
checkpoints/
runs/
*.ckpt
*.pt
*.pth

# Notebooks / scratch
*.ipynb
scratch/

# OS / IDE
.DS_Store
.idea/
.vscode/
